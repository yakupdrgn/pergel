<?xml version="1.0"?>
<ruleset name="Pergel">
	<description>WordPress Coding Standards for Pergel, PHP 8.1+ compatible.</description>

	<file>theme</file>
	<file>engine</file>
	<file>tools</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>engine/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files (Plugin.php) instead of class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="pergel"/>
				<element value="pergel-engine"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="pergel"/>
				<element value="Pergel"/>
			</property>
		</properties>
	</rule>
	<!-- Token compiler and dev tools run only under WP-CLI or CI; their exception
	     messages go to a terminal, never into HTML. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>engine/src/Tokens/*</exclude-pattern>
		<exclude-pattern>tools/*</exclude-pattern>
	</rule>
	<!-- Hook names use the pergel/ namespace style (pergel/modules). -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>
</ruleset>

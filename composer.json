{
	"name": "ariumlab/pergel",
	"description": "Pergel block theme and Pergel Engine plugin (development tooling).",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^10.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload-dev": {
		"psr-4": {
			"Pergel\\": "engine/src/",
			"Pergel\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		],
		"test": "phpunit",
		"pot": [
			"wp i18n make-pot theme theme/languages/pergel.pot --slug=pergel --domain=pergel --exclude=tokens --no-location",
			"wp i18n make-pot engine engine/languages/pergel-engine.pot --slug=pergel-engine --domain=pergel-engine --exclude=build --no-location"
		]
	}
}

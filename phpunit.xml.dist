<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="vendor/autoload.php"
	colors="true"
	failOnWarning="true"
	failOnRisky="true"
	cacheDirectory=".phpunit.cache">
	<!-- Unit tests for code that runs without WordPress (token compiler,
	     settings schema). Tests that need a site are in tests/integration
	     and run with phpunit-integration.xml.dist (composer test:integration). -->
	<testsuites>
		<testsuite name="unit">
			<directory>tests/php</directory>
		</testsuite>
	</testsuites>
</phpunit>

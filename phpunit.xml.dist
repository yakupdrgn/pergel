<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="vendor/autoload.php"
	colors="true"
	failOnWarning="true"
	failOnRisky="true"
	cacheDirectory=".phpunit.cache">
	<!-- Unit tests for code that runs without WordPress (token compiler).
	     Tests that need a site run against the CI WordPress install. -->
	<testsuites>
		<testsuite name="unit">
			<directory>tests/php</directory>
		</testsuite>
	</testsuites>
</phpunit>

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pergel/shop-list",
	"title": "Wishlist or compare list",
	"category": "pergel",
	"icon": "list-view",
	"description": "The products a visitor saved to the wishlist or chose to compare. Put it on the page set under Dashboard → Pergel → Shop.",
	"keywords": [ "wishlist", "compare", "favourites", "comparison" ],
	"textdomain": "pergel-engine",
	"attributes": {
		"kind": {
			"type": "string",
			"enum": [ "wishlist", "compare" ],
			"default": "wishlist"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}

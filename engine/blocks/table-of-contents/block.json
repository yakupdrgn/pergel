{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pergel/table-of-contents",
	"title": "Table of contents",
	"category": "pergel",
	"icon": "list-view",
	"description": "Links to the headings of the content. Headings get their anchors when the page renders.",
	"keywords": [ "contents", "toc", "headings", "anchors", "summary" ],
	"textdomain": "pergel-engine",
	"usesContext": [ "postId" ],
	"attributes": {
		"maxLevel": {
			"type": "integer",
			"enum": [ 2, 3, 4 ],
			"default": 3
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"link": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"styles": [
		{ "name": "default", "label": "List", "isDefault": true },
		{ "name": "bar", "label": "Bar" }
	],
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}

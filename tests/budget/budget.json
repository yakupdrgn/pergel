{
	"$comment": "Performance budget (plan K11). A change that breaks a limit is not merged. A number is a maximum; [min, max] is a range. A page with \"variation\" is rendered with that style variation; its \"limits\" override the shared ones. Shop/catalog pages are added with the WooCommerce module (F4).",
	"runs": 3,
	"pages": [
		{ "name": "front", "path": "/" },
		{ "name": "blog", "path": "/blog/" },
		{ "name": "post", "path": "/pergel-sample-post/" },
		{ "name": "page", "path": "/pergel-sample-page/" },
		{ "name": "category", "path": "/category/pergel-test/" },
		{ "name": "search", "path": "/?s=pergel" },
		{ "name": "404", "path": "/pergel-budget-missing/", "status": 404 },
		{ "name": "front@lab-precision", "path": "/", "variation": "lab-precision", "limits": { "fontKB": 120 } },
		{ "name": "post@lab-precision", "path": "/pergel-sample-post/", "variation": "lab-precision", "limits": { "fontKB": 120 } },
		{ "name": "front@graphite", "path": "/", "variation": "graphite", "limits": { "fontKB": 95 } },
		{ "name": "post@graphite", "path": "/pergel-sample-post/", "variation": "graphite", "limits": { "fontKB": 95 } },
		{ "name": "front@clinical-air", "path": "/", "variation": "clinical-air", "limits": { "fontKB": 45 } },
		{ "name": "post@clinical-air", "path": "/pergel-sample-post/", "variation": "clinical-air", "limits": { "fontKB": 45 } }
	],
	"limits": {
		"*": {
			"pergel_files": 60,
			"queries": 75,
			"writes": 0,
			"htmlKB": 100,
			"requests": 30,
			"jsKB": 30,
			"cssKB": 60,
			"fontKB": 0,
			"bodyCssLinks": 0,
			"h1": [ 1, 1 ],
			"axe": 0
		}
	}
}

<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/integration/bootstrap.php"
	colors="true"
	failOnWarning="true"
	failOnRisky="true"
	cacheDirectory=".phpunit.cache">
	<!-- Tests that need WordPress. They run against an installed site
	     (PERGEL_WP_DIR), see tests/integration/bootstrap.php:
	       PERGEL_WP_DIR=/tmp/pergel-wp composer test:integration -->
	<testsuites>
		<testsuite name="integration">
			<directory>tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>

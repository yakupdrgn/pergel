{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"viewport": {
			"mobile": "600px",
			"tablet": "1024px"
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#f4f5f7"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#16181d"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5b6270"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#dde0e6"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#1f4fd1"
				},
				{
					"slug": "on-accent",
					"name": "On accent",
					"color": "#ffffff"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "2XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "XS",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "50",
					"name": "M",
					"size": "clamp(1.25rem, 1.1477rem + 0.4545vw, 1.5rem)"
				},
				{
					"slug": "60",
					"name": "L",
					"size": "clamp(1.75rem, 1.4432rem + 1.3636vw, 2.5rem)"
				},
				{
					"slug": "70",
					"name": "XL",
					"size": "clamp(2.5rem, 1.8864rem + 2.7273vw, 4rem)"
				},
				{
					"slug": "80",
					"name": "2XL",
					"size": "clamp(3.5rem, 2.2727rem + 5.4545vw, 6.5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "System sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Headings",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "System mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3rem",
					"fluid": {
						"min": "2.125rem",
						"max": "3rem"
					}
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"slug": "small",
					"name": "Small",
					"shadow": "0 1px 2px 0 #16181d14"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"shadow": "0 2px 4px 0 #16181d0f, 0 8px 24px -4px #16181d14"
				}
			],
			"defaultPresets": false
		},
		"custom": {
			"radius": {
				"small": "4px",
				"medium": "8px",
				"large": "16px",
				"button": "4px",
				"card": "8px"
			},
			"font-weight": {
				"body": 400,
				"heading": 650,
				"button": 600
			},
			"line-height": {
				"body": 1.6,
				"heading": 1.2
			},
			"logo": {
				"height": "40px",
				"max-width": "240px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0px",
				"right": "var(--wp--preset--spacing--50)",
				"bottom": "0px",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "var(--wp--custom--font-weight--body)",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "var(--wp--custom--font-weight--heading)",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button)"
				},
				"typography": {
					"fontWeight": "var(--wp--custom--font-weight--button)"
				}
			}
		},
		"blocks": {
			"core/accordion-heading": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"core/accordion-item": {
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--line)",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "var(--wp--custom--font-weight--heading)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "inherit"
						}
					}
				}
			},
			"core/archives": {
				"css": "& li + li { margin-block-start: 0.5em; }"
			},
			"core/categories": {
				"css": "& li + li { margin-block-start: 0.5em; }"
			},
			"core/latest-posts": {
				"css": "& li + li { margin-block-start: 0.5em; }"
			},
			"core/page-list": {
				"css": "& li + li { margin-block-start: 0.5em; }"
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontStyle": "italic"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing page (no title)",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "mega-menu",
			"title": "Mega menu",
			"area": "pergel-mega-menu"
		}
	]
}

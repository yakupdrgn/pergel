{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Lab Precision",
	"styles": {
		"elements": {
			"button": {
				"typography": {
					"textTransform": "uppercase",
					"letterSpacing": "0.04em"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"textTransform": "uppercase",
					"letterSpacing": "0.04em",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		}
	},
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#f5f7f8"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#242424"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5e6672"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#1919191a"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#1e64e6"
				},
				{
					"slug": "on-accent",
					"name": "On accent",
					"color": "#ffffff"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Figtree",
					"fontFamily": "Figtree, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree/figtree-latin-wght-normal.woff2"
							],
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Figtree",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree/figtree-latin-ext-wght-normal.woff2"
							],
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "heading",
					"name": "Lexend Exa",
					"fontFamily": "\"Lexend Exa\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Lexend Exa",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lexend-exa/lexend-exa-latin-wght-normal.woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Lexend Exa",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lexend-exa/lexend-exa-latin-ext-wght-normal.woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "mono",
					"name": "System mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "2.625rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.625rem"
					}
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "20",
					"name": "2XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "XS",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "50",
					"name": "M",
					"size": "clamp(1.25rem, 1.1774rem + 0.3226vw, 1.5rem)"
				},
				{
					"slug": "60",
					"name": "L",
					"size": "clamp(1.75rem, 1.5323rem + 0.9677vw, 2.5rem)"
				},
				{
					"slug": "70",
					"name": "XL",
					"size": "clamp(2.5rem, 2.0645rem + 1.9355vw, 4rem)"
				},
				{
					"slug": "80",
					"name": "2XL",
					"size": "clamp(3.5rem, 2.629rem + 3.871vw, 6.5rem)"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"slug": "small",
					"name": "Small",
					"shadow": "0 1px 2px 0 #16181d14"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"shadow": "0 2px 4px 0 #16181d0f, 0 8px 24px -4px #16181d14"
				}
			],
			"defaultPresets": false
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1600px"
		},
		"custom": {
			"radius": {
				"small": "5px",
				"medium": "12px",
				"large": "35px",
				"button": "5px",
				"card": "12px"
			},
			"logo": {
				"height": "40px",
				"max-width": "240px"
			},
			"font-weight": {
				"body": 400,
				"heading": 500,
				"button": 600
			},
			"line-height": {
				"body": 1.6,
				"heading": 1.2
			}
		}
	}
}

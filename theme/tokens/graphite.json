{
	"$description": "Graphite Engineering: dark graphite surfaces from the ariumlab footer, a lighter blue that stays readable on dark, tight radii. Space Grotesk headings, Geist body.",
	"$extensions": {
		"com.ariumlab.pergel": {
			"title": "Graphite Engineering",
			"styles": {
				"elements": {
					"heading": { "typography": { "letterSpacing": "-0.01em" } }
				}
			}
		}
	},
	"color": {
		"base": { "$value": "#191919" },
		"surface": { "$value": "#242424" },
		"contrast": { "$value": "#eef1f5" },
		"muted": { "$value": "#a4abb6" },
		"border": { "$value": "#ffffff1f" },
		"accent": { "$value": "#4c8dff" },
		"on-accent": { "$value": "#0b0d10" }
	},
	"font-family": {
		"body": {
			"$value": [ "Geist", "system-ui", "sans-serif" ],
			"$extensions": { "com.ariumlab.pergel": { "name": "Geist",
				"fontFace": [
					{ "src": "file:./assets/fonts/geist/geist-latin-wght-normal.woff2", "fontWeight": "100 900", "fontStyle": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
					{ "src": "file:./assets/fonts/geist/geist-latin-ext-wght-normal.woff2", "fontWeight": "100 900", "fontStyle": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
				]
			} }
		},
		"heading": {
			"$value": [ "Space Grotesk", "system-ui", "sans-serif" ],
			"$extensions": { "com.ariumlab.pergel": { "name": "Space Grotesk",
				"fontFace": [
					{ "src": "file:./assets/fonts/space-grotesk/space-grotesk-latin-wght-normal.woff2", "fontWeight": "300 700", "fontStyle": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
					{ "src": "file:./assets/fonts/space-grotesk/space-grotesk-latin-ext-wght-normal.woff2", "fontWeight": "300 700", "fontStyle": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
				]
			} }
		}
	},
	"radius": {
		"small": { "$value": { "value": 4, "unit": "px" } },
		"medium": { "$value": { "value": 10, "unit": "px" } }
	},
	"font-weight": {
		"heading": { "$value": 600 },
		"button": { "$value": 600 }
	},
	"shadow": {
		"small": {
			"$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
		},
		"medium": {
			"$value": [
				{ "color": "#0000004d", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" },
				{ "color": "#00000066", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-6px" }
			]
		}
	}
}

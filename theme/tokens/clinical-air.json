{
	"$description": "Clinical Air: white and airy for a laboratory audience. Navy text, a deep teal accent that passes AA on white, pill buttons, larger radii. Manrope throughout.",
	"$extensions": {
		"com.ariumlab.pergel": { "title": "Clinical Air" }
	},
	"color": {
		"base": { "$value": "#ffffff" },
		"surface": { "$value": "#f1f6f9" },
		"contrast": { "$value": "#0f2a5c" },
		"muted": { "$value": "#4d5b72" },
		"line": { "$value": "#0f2a5c1f" },
		"accent": { "$value": "#00787a" },
		"on-accent": { "$value": "#ffffff" }
	},
	"font-family": {
		"body": {
			"$value": [ "Manrope", "system-ui", "sans-serif" ],
			"$extensions": { "com.ariumlab.pergel": { "name": "Manrope",
				"fontFace": [
					{ "src": "file:./assets/fonts/manrope/manrope-latin-wght-normal.woff2", "fontWeight": "200 800", "fontStyle": "normal", "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
					{ "src": "file:./assets/fonts/manrope/manrope-latin-ext-wght-normal.woff2", "fontWeight": "200 800", "fontStyle": "normal", "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
				]
			} }
		},
		"heading": { "$value": "{font-family.body}", "$extensions": { "com.ariumlab.pergel": { "name": "Headings" } } }
	},
	"radius": {
		"small": { "$value": { "value": 8, "unit": "px" } },
		"medium": { "$value": { "value": 16, "unit": "px" } },
		"large": { "$value": { "value": 24, "unit": "px" } },
		"button": { "$value": { "value": 999, "unit": "px" } }
	},
	"font-weight": {
		"heading": { "$value": 700 },
		"button": { "$value": 700 }
	},
	"shadow": {
		"small": {
			"$value": { "color": "#0f2a5c14", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
		},
		"medium": {
			"$value": [
				{ "color": "#0f2a5c0a", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" },
				{ "color": "#0f2a5c14", "offsetX": "0px", "offsetY": "16px", "blur": "40px", "spread": "-8px" }
			]
		}
	}
}
